@baseUrl = http://localhost:3000
@adminToken = REEMPLAZAR_TOKEN_ADMIN
@userToken = REEMPLAZAR_TOKEN_USUARIO
@categoriaId = 1
@categoriaEditableId = 16
@categoriaInexistenteId = 999999

### Obtener categorias
GET {{baseUrl}}/api/categorias
Authorization: Bearer {{userToken}}

###

### Obtener categoria por id
GET {{baseUrl}}/api/categorias/{{categoriaId}}
Authorization: Bearer {{userToken}}

###

### Obtener categoria inexistente
GET {{baseUrl}}/api/categorias/{{categoriaInexistenteId}}
Authorization: Bearer {{userToken}}

###

### Crear categoria
POST {{baseUrl}}/api/categorias
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "nombre": "Categoria creada desde REST Client"
}

###

### Actualizar categoria
PUT {{baseUrl}}/api/categorias/{{categoriaEditableId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "nombre": "Categoria editada desde REST Client"
}

###

### Eliminar categoria editable
DELETE {{baseUrl}}/api/categorias/{{categoriaEditableId}}
Authorization: Bearer {{adminToken}}

###

### Intentar eliminar categoria protegida
DELETE {{baseUrl}}/api/categorias/{{categoriaId}}
Authorization: Bearer {{adminToken}}

###

### Obtener categorias sin token
GET {{baseUrl}}/api/categorias