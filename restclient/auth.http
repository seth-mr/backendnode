@baseUrl = http://localhost:3000
@adminEmail = cuentadesoportea@gmail.com
@adminPassword = Administrador1234@
@userEmail = cuentadesoportec@gmail.com
@userPassword = Usuario1234@
@adminToken = REEMPLAZAR_TOKEN_ADMIN
@userToken = REEMPLAZAR_TOKEN_USUARIO
@registroEmail = usuario.nuevo@example.com
@registroPassword = Password123@
@verificationCode = 12345

### Login de administrador
POST {{baseUrl}}/api/auth
Content-Type: application/json

{
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
}

###

### Login de usuario
POST {{baseUrl}}/api/auth
Content-Type: application/json

{
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
}

###

### Login invalido
POST {{baseUrl}}/api/auth
Content-Type: application/json

{
    "email": "{{adminEmail}}",
    "password": "incorrecta"
}

###

### Solicitar registro
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
    "nombre": "Usuario",
    "apellido": "Prueba",
    "email": "{{registroEmail}}",
    "password": "{{registroPassword}}",
    "confirmPassword": "{{registroPassword}}"
}

###

### Solicitar registro con correo ya existente
POST {{baseUrl}}/api/auth/registro
Content-Type: application/json

{
    "nombre": "Seth",
    "apellido": "Marquez",
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}",
    "confirmPassword": "{{adminPassword}}"
}

###

### Verificar registro pendiente
POST {{baseUrl}}/api/auth/registro/verificar
Content-Type: application/json

{
    "email": "{{registroEmail}}",
    "codigo": "{{verificationCode}}"
}

###

### Verificar registro con codigo invalido
POST {{baseUrl}}/api/auth/registro/verificar
Content-Type: application/json

{
    "email": "{{registroEmail}}",
    "codigo": "00000"
}

###

### Consultar tiempo restante del token
GET {{baseUrl}}/api/auth/tiempo
Authorization: Bearer {{adminToken}}

###

### Consultar tiempo sin token
GET {{baseUrl}}/api/auth/tiempo